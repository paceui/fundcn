    "@tanstack/router-plugin": "1.168.41",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide": "^1.48.0",
    "lucide-react": "^1.48.0",
    "morphicons": "^1.7.1",
    "motion": "^13.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
